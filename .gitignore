# Maestro Framework .gitignore

# Node.js dependencies
node_modules/
.claude/hooks/node_modules/

# macOS artifacts
.DS_Store

# General logs
*.log

# Maestro work tracker output
.maestro-work-log.txt
# Runtime context tracking
.claude/context.json

# Runtime artifacts
.claude/sessions/*.backup.json
.claude/sessions/archives/
.claude/ipc/registry.json
.claude/ipc/mailbox-*.json
.claude/_stashed/
__pycache__/
.codex-work-log.txt
